<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dominó PRO — Tabuleiro Curvo</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

:root{
  --bg:#06101c;
  --panel:#0c1b2d;
  --panel2:#132941;
  --accent:#00e5ff;
  --purple:#7c4dff;
  --text:#f4f7fb;
  --muted:#91a6bf;
  --green:#00e676;
  --gold:#ffd740;
}

body{
  min-height:100vh;
  font-family:Arial,Helvetica,sans-serif;
  color:var(--text);
  background:radial-gradient(circle at top,#173c65 0,#07111e 45%,#02070d 100%);
  overflow-x:hidden;
}

/* =========================
   TELA DE CAPA (SPLASH)
========================= */
.splash-screen{
  position:fixed;
  inset:0;
  background:radial-gradient(circle at center, #173c65 0, #07111e 60%, #02070d 100%);
  z-index:999;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:20px;
  transition:opacity .4s ease, visibility .4s ease;
}

.splash-screen.hidden{
  opacity:0;
  visibility:hidden;
  pointer-events:none;
}

.splash-logo-container{
  position:relative;
  width:140px;
  height:140px;
  display:flex;
  align-items:center;
  justify-content:center;
  margin-bottom:20px;
}

.splash-rings{
  position:absolute;
  inset:0;
  border:2px dashed var(--accent);
  border-radius:50%;
  animation: spinRings 10s linear infinite;
  box-shadow:0 0 25px rgba(0,229,255,.3);
}

@keyframes spinRings {
  100% { transform: rotate(360deg); }
}

.splash-domino{
  width:60px;
  height:100px;
  background:linear-gradient(145deg,#ffffff,#d8e0e8);
  border:2px solid var(--accent);
  border-radius:10px;
  display:flex;
  flex-direction:column;
  box-shadow:0 0 20px rgba(0,229,255,.6);
  transform:rotate(-15deg);
}

.splash-domino .half{
  flex:1;
  display:flex;
  align-items:center;
  justify-content:center;
  position:relative;
}
.splash-domino .half:first-child{
  border-bottom:2px solid #777;
}
.splash-dot{
  width:8px;
  height:8px;
  background:#111;
  border-radius:50%;
  position:absolute;
}

.splash-title{
  font-size:clamp(2.2rem, 6vw, 3.8rem);
  font-weight:900;
  background:linear-gradient(90deg,#00e5ff,#fff,#8d65ff);
  -webkit-background-clip:text;
  color:transparent;
  text-align:center;
  margin-bottom:5px;
  filter:drop-shadow(0 4px 15px rgba(0,229,255,.4));
}

.splash-subtitle{
  color:var(--muted);
  font-size:1.1rem;
  margin-bottom:35px;
  text-align:center;
}

.splash-buttons{
  display:flex;
  flex-direction:column;
  gap:14px;
  width:min(320px, 100%);
  align-items:center;
}

.btn-splash-main{
  width:100%;
  padding:16px 24px;
  font-size:1.15rem;
  font-weight:bold;
  border-radius:16px;
  border:none;
  background:linear-gradient(135deg,#00b4d8,#7c4dff);
  color:white;
  cursor:pointer;
  box-shadow:0 0 25px rgba(0,229,255,.4);
  transition:.2s;
  text-transform:uppercase;
  letter-spacing:1px;
}
.btn-splash-main:hover{
  transform:translateY(-3px);
  box-shadow:0 0 35px rgba(0,229,255,.7);
}

.splash-row-btns{
  display:flex;
  gap:10px;
  width:100%;
}

.btn-splash-sub{
  flex:1;
  padding:12px 15px;
  font-size:.95rem;
  font-weight:bold;
  border-radius:12px;
  border:1px solid #294765;
  background:var(--panel2);
  color:white;
  cursor:pointer;
  transition:.2s;
}
.btn-splash-sub:hover{
  border-color:var(--accent);
  transform:translateY(-2px);
}

/* =========================
   ESTRUTURA DO JOGO
========================= */
.app{
  width:min(1200px,96%);
  margin:auto;
  padding:20px 0 40px;
}

header{
  text-align:center;
  margin-bottom:18px;
}

header h1{
  font-size:clamp(2rem,5vw,3.5rem);
  font-weight:900;
  background:linear-gradient(90deg,#00e5ff,#fff,#8d65ff);
  -webkit-background-clip:text;
  color:transparent;
}

header p{
  color:var(--muted);
  margin-top:5px;
}

.topbar{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:10px;
  margin-bottom:15px;
}

.btn{
  border:1px solid #294765;
  background:var(--panel2);
  color:white;
  padding:11px 18px;
  border-radius:12px;
  cursor:pointer;
  font-weight:bold;
  transition:.2s;
}

.btn:hover{
  transform:translateY(-2px);
  border-color:var(--accent);
}

.btn.primary{
  background:linear-gradient(135deg,#008da8,#6840d9);
  border:0;
}

.btn.green{
  background:#087c49;
}

.btn.hint-btn{
  background:#b7791f;
  border-color:#d69e2e;
}

.game{
  background:rgba(12,27,45,.96);
  border:1px solid #203d5c;
  border-radius:22px;
  padding:18px;
  box-shadow:0 20px 60px rgba(0,0,0,.4);
}

.info{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
  margin-bottom:15px;
}

.stat{
  text-align:center;
  background:#081625;
  border:1px solid #1c3550;
  border-radius:14px;
  padding:11px;
}

.stat span{
  display:block;
  color:var(--muted);
  font-size:.8rem;
}

.stat strong{
  display:block;
  margin-top:4px;
}

.status{
  text-align:center;
  background:#081625;
  border:1px solid #1d3a57;
  border-radius:14px;
  padding:13px;
  margin-bottom:15px;
}

/* =========================
   ÁREA DO TABULEIRO
========================= */
.board{
  position:relative;
  height:430px;
  overflow-y:auto;
  overflow-x:auto;
  border-radius:22px;
  padding:25px;
  background:radial-gradient(circle at center,#126149,#083c30 55%,#05251f);
  border:5px solid #70431e;
  box-shadow:inset 0 0 35px rgba(0,0,0,.55), 0 10px 30px rgba(0,0,0,.25);
}

.board::before{
  content:"";
  position:absolute;
  inset:20px;
  border:1px solid rgba(255,255,255,.06);
  border-radius:18px;
  pointer-events:none;
}

.chain{
  width:100%;
  height:100%;
  display:flex;
  justify-content:center;
  align-items:center;
  flex-wrap:wrap;
  align-content:center;
  gap:7px;
  position:relative;
  min-width: 600px;
}

/* =========================
   PEÇA
========================= */
.domino{
  width:54px;
  height:92px;
  border-radius:9px;
  background:linear-gradient(145deg,#ffffff,#d8e0e8);
  border:2px solid #aeb8c3;
  box-shadow:0 5px 12px rgba(0,0,0,.4);
  display:flex;
  flex-direction:column;
  overflow:hidden;
  flex-shrink:0;
  color:#111;
}

.chain .domino{
  width:92px;
  height:54px;
  flex-direction:row;
  transition:.25s;
}

.chain .domino.vertical{
  width:54px;
  height:92px;
  flex-direction:column;
}

.chain .domino:not(.vertical) .half{
  width:50%;
  height:100%;
}

.chain .domino:not(.vertical) .half:first-child{
  border-right:2px solid #777;
  border-bottom:0;
}

.chain .domino.vertical .half{
  width:100%;
  height:50%;
}

.chain .domino.vertical .half:first-child{
  border-right:0;
  border-bottom:2px solid #777;
}

.half{
  display:flex;
  align-items:center;
  justify-content:center;
  position:relative;
}

.dots{
  width:34px;
  height:34px;
  position:relative;
}

.dot{
  position:absolute;
  width:7px;
  height:7px;
  background:#111;
  border-radius:50%;
}

.tl{left:2px;top:2px}
.tc{left:13px;top:2px}
.tr{right:2px;top:2px}
.ml{left:2px;top:13px}
.mc{left:13px;top:13px}
.mr{right:2px;top:13px}
.bl{left:2px;bottom:2px}
.bc{left:13px;bottom:2px}
.br{right:2px;bottom:2px}

/* =========================
   COMPUTADOR
========================= */
.area-title{
  color:var(--muted);
  font-size:.9rem;
  margin-bottom:8px;
}

.hidden-hand{
  min-height:58px;
  display:flex;
  justify-content:center;
  gap:7px;
}

.back{
  width:36px;
  height:58px;
  border-radius:7px;
  background:repeating-linear-gradient(45deg,#132d4b,#132d4b 5px,#1d4b77 5px,#1d4b77 10px);
  border:2px solid #4e7da7;
}

/* =========================
   JOGADOR
========================= */
.player-area{
  margin-top:15px;
}

.hand{
  min-height:100px;
  display:flex;
  justify-content:center;
  gap:8px;
  flex-wrap:wrap;
}

.player-piece{
  cursor:pointer;
  transition:.2s;
}

.player-piece:hover{
  transform:translateY(-10px);
  border-color:var(--accent);
  box-shadow:0 0 20px rgba(0,229,255,.5);
}

.player-piece.disabled{
  opacity:.45;
  cursor:not-allowed;
}

.player-piece.hint-highlight{
  border-color:var(--gold) !important;
  box-shadow:0 0 22px var(--gold) !important;
  transform: translateY(-8px);
}

.controls{
  display:flex;
  justify-content:center;
  gap:10px;
  flex-wrap:wrap;
  margin-top:12px;
}

.rules{
  margin-top:15px;
  padding:16px;
  background:#081625;
  border:1px solid #1d3854;
  border-radius:16px;
}

.rules h2{
  margin-bottom:8px;
}

.rules ul{
  padding-left:20px;
  line-height:1.7;
  color:#cbd8e8;
}

/* =========================
   MODAL / CONFIGURAÇÕES
========================= */
.modal{
  position:fixed;
  inset:0;
  display:none;
  align-items:center;
  justify-content:center;
  background:rgba(0,0,0,.78);
  z-index:1000;
  padding:20px;
}

.modal.show{
  display:flex;
}

.modal-box{
  width:min(450px,100%);
  background:#0c1b2d;
  border:1px solid #31516f;
  border-radius:20px;
  padding:25px;
  text-align:center;
}

.modal-box h2{
  color:var(--gold);
  margin-bottom:10px;
}

.modal-box p{
  color:#cbd8e8;
  line-height:1.6;
  margin-bottom:18px;
  text-align:left;
}

.form-group{
  margin-bottom:15px;
  text-align:left;
}

.form-group label{
  display:block;
  color:var(--muted);
  font-size:.9rem;
  margin-bottom:6px;
}

.form-group select{
  width:100%;
  padding:10px;
  background:#081625;
  border:1px solid #294765;
  color:white;
  border-radius:10px;
  font-size:1rem;
}

@media(max-width:700px){
  .info{
    grid-template-columns:repeat(2,1fr);
  }
  .board{
    height:390px;
    padding:12px;
  }
  .chain .domino{
    width:76px;
    height:45px;
  }
  .chain .domino.vertical{
    width:45px;
    height:76px;
  }
  .dots{
    transform:scale(.75);
  }
}
</style>
</head>

<body>

<!-- TELA DE CAPA (SPLASH SCREEN) -->
<div class="splash-screen" id="splashScreen">
  <div class="splash-logo-container">
    <div class="splash-rings"></div>
    <div class="splash-domino">
      <div class="half">
        <span class="splash-dot" style="left:5px;top:5px;"></span>
        <span class="splash-dot" style="right:5px;bottom:5px;"></span>
      </div>
      <div class="half">
        <span class="splash-dot" style="left:5px;top:5px;"></span>
        <span class="splash-dot" style="right:5px;bottom:5px;"></span>
        <span class="splash-dot" style="left:12px;top:12px;"></span>
      </div>
    </div>
  </div>

  <h1 class="splash-title">DOMINÓ PRO</h1>
  <p class="splash-subtitle">Desafie a Sorte e a Estratégia</p>

  <div class="splash-buttons">
    <button class="btn-splash-main" onclick="closeSplash()">INICIAR JOGO</button>
    <div class="splash-row-btns">
      <button class="btn-splash-sub" onclick="openRulesModal()">Como Jogar</button>
      <button class="btn-splash-sub" onclick="openSettingsModal()">Configurações</button>
    </div>
  </div>
</div>

<div class="app">

<header>
  <h1>🁣 DOMINÓ PRO</h1>
  <p>Tabuleiro com corrente visual e Inteligência Artificial</p>
</header>

<div class="topbar">
  <button class="btn primary" onclick="newGame()">🔄 Novo Jogo</button>
  <button class="btn" onclick="openRulesModal()">📖 Regras</button>
  <button class="btn" onclick="openSettingsModal()">⚙️ Configurações</button>
</div>

<div class="game">

<div class="info">
  <div class="stat">
    <span>Jogador</span>
    <strong id="playerCount">0 peças</strong>
  </div>
  <div class="stat">
    <span>Computador</span>
    <strong id="cpuCount">0 peças</strong>
  </div>
  <div class="stat">
    <span>Monte</span>
    <strong id="deckCount">0 peças</strong>
  </div>
  <div class="stat">
    <span>Placar</span>
    <strong id="score">0 × 0</strong>
  </div>
</div>

<div class="status" id="status">
  Clique em "Iniciar Jogo".
</div>

<div>
  <div class="area-title">🤖 Mão do Computador</div>
  <div class="hidden-hand" id="cpuHand"></div>
</div>

<!-- TABULEIRO -->
<div class="board">
  <div class="chain" id="board">
    <span style="color:#b9d4cb">A corrente de dominó aparecerá aqui</span>
  </div>
</div>

<div class="player-area">
  <div class="area-title">👤 Sua Mão — clique para jogar</div>
  <div class="hand" id="playerHand"></div>
</div>

<div class="controls">
  <button class="btn green" onclick="drawPiece()">➕ Comprar Peça</button>
  <button class="btn hint-btn" onclick="showHint()">💡 Dica</button>
  <button class="btn" onclick="passTurn()">⏭ Passar</button>
</div>

<div class="rules">
  <h2>📜 Regras Rápidas</h2>
  <ul>
    <li>28 peças no dominó tradicional. Cada jogador começa com 7 peças.</li>
    <li>Combine uma peça com uma das pontas abertas da mesa.</li>
    <li>Se não tiver jogada, compre do monte. Se o monte acabar, passe a vez.</li>
    <li>Quem ficar sem peças na mão primeiro vence a rodada!</li>
  </ul>
</div>

</div>
</div>

<!-- MODAL DE FIM DE RODADA -->
<div class="modal" id="modal">
  <div class="modal-box">
    <h2>🏆 Fim da Rodada</h2>
    <p id="resultText"></p>
    <button class="btn primary" style="width:100%;" onclick="closeModal();newGame()">🔄 Jogar Novamente</button>
  </div>
</div>

<!-- MODAL DE REGRAS -->
<div class="modal" id="rulesModal">
  <div class="modal-box">
    <h2>📖 Como Jogar</h2>
    <p>
      1. O jogo começa distribuindo 7 peças para você e 7 para o computador.<br>
      2. Na sua vez, selecione uma peça que coincida com o número de pontos de uma das pontas correntes da mesa.<br>
      3. Caso não possua peças válidas, utilize o botão <strong>Comprar Peça</strong>.<br>
      4. Se o monte estiver vazio e você não puder jogar, utilize o botão <strong>Passar</strong>.<br>
      5. O primeiro a esvaziar a mão vence a rodada!
    </p>
    <button class="btn primary" style="width:100%;" onclick="closeRulesModal()">Entendi</button>
  </div>
</div>

<!-- MODAL DE CONFIGURAÇÕES -->
<div class="modal" id="settingsModal">
  <div class="modal-box">
    <h2>⚙️ Configurações</h2>
    <div class="form-group">
      <label for="aiDifficulty">Dificuldade da IA:</label>
      <select id="aiDifficulty" onchange="changeDifficulty(this.value)">
        <option value="easy">Fácil (Iniciante)</option>
        <option value="medium" selected>Médio (Estratégico)</option>
        <option value="hard">Difícil (Mestre)</option>
      </select>
    </div>
    <button class="btn primary" style="width:100%;" onclick="closeSettingsModal()">Salvar e Fechar</button>
  </div>
</div>

<script>
let deck = [];
let player = [];
let cpu = [];
let board = [];
let turn = "player";
let playerScore = 0;
let cpuScore = 0;
let gameOver = false;
let aiDifficulty = "medium";

const $ = id => document.getElementById(id);

function closeSplash(){
  $("splashScreen").classList.add("hidden");
  startGame();
}

function openRulesModal(){ $("rulesModal").classList.add("show"); }
function closeRulesModal(){ $("rulesModal").classList.remove("show"); }

function openSettingsModal(){ $("settingsModal").classList.add("show"); }
function closeSettingsModal(){ $("settingsModal").classList.remove("show"); }

function changeDifficulty(val){
  aiDifficulty = val;
}

/* =========================
   BARALHO E JOGO
========================= */
function createDeck(){
  const d = [];
  for(let a=0; a<=6; a++){
    for(let b=a; b<=6; b++){
      d.push([a,b]);
    }
  }
  return d;
}

function shuffle(array){
  for(let i=array.length-1; i>0; i--){
    const j = Math.floor(Math.random()*(i+1));
    [array[i], array[j]] = [array[j], array[i]];
  }
}

function startGame(){
  playerScore = 0;
  cpuScore = 0;
  newRound();
}

function newGame(){
  newRound();
}

function newRound(){
  deck = createDeck();
  shuffle(deck);
  player = deck.splice(0, 7);
  cpu = deck.splice(0, 7);
  board = [];
  turn = "player";
  gameOver = false;
  render();
  setStatus("👤 Sua vez! Escolha uma peça ou compre se necessário.");
}

/* =========================
   RENDERIZAÇÃO
========================= */
function render(){
  renderPlayer();
  renderCPU();
  renderBoard();

  $("playerCount").textContent = player.length + " peças";
  $("cpuCount").textContent = cpu.length + " peças";
  $("deckCount").textContent = deck.length + " peças";
  $("score").textContent = playerScore + " × " + cpuScore;
}

function renderPlayer(){
  const hand = $("playerHand");
  hand.innerHTML = "";
  player.forEach((piece, index) => {
    const el = createDomino(piece[0], piece[1]);
    el.classList.add("player-piece");
    if(turn !== "player" || !canPlay(piece)){
      el.classList.add("disabled");
    } else {
      el.onclick = () => playPlayer(index);
    }
    hand.appendChild(el);
  });
}

function renderCPU(){
  const hand = $("cpuHand");
  hand.innerHTML = "";
  cpu.forEach(() => {
    const back = document.createElement("div");
    back.className = "back";
    hand.appendChild(back);
  });
}

function renderBoard(){
  const area = $("board");
  area.innerHTML = "";
  if(board.length === 0){
    area.innerHTML = '<span style="color:#b9d4cb">A corrente de dominó aparecerá aqui</span>';
    return;
  }
  board.forEach((piece, index) => {
    const el = createDomino(piece[0], piece[1]);
    if(index % 5 === 4){
      el.classList.add("vertical");
    }
    area.appendChild(el);
  });
}

function createDomino(a, b){
  const el = document.createElement("div");
  el.className = "domino";
  el.appendChild(createHalf(a));
  el.appendChild(createHalf(b));
  return el;
}

function createHalf(value){
  const half = document.createElement("div");
  half.className = "half";
  const dots = document.createElement("div");
  dots.className = "dots";

  const positions = {
    0: [],
    1: ["mc"],
    2: ["tl", "br"],
    3: ["tl", "mc", "br"],
    4: ["tl", "tr", "bl", "br"],
    5: ["tl", "tr", "mc", "bl", "br"],
    6: ["tl", "ml", "bl", "tr", "mr", "br"]
  };

  positions[value].forEach(pos => {
    const dot = document.createElement("span");
    dot.className = "dot " + pos;
    dots.appendChild(dot);
  });

  half.appendChild(dots);
  return half;
}

/* =========================
   LÓGICA DE JOGADAS
========================= */
function canPlay(piece){
  if(board.length === 0) return true;
  const left = board[0][0];
  const right = board[board.length - 1][1];
  return (piece[0] === left || piece[1] === left || piece[0] === right || piece[1] === right);
}

function placePiece(piece){
  if(board.length === 0){
    board.push(piece);
    return;
  }
  const left = board[0][0];
  const right = board[board.length - 1][1];

  if(piece[1] === left){
    board.unshift(piece);
  }else if(piece[0] === left){
    board.unshift([piece[1], piece[0]]);
  }else if(piece[0] === right){
    board.push(piece);
  }else if(piece[1] === right){
    board.push([piece[1], piece[0]]);
  }
}

/* =========================
   JOGADOR
========================= */
function playPlayer(index){
  if(turn !== "player" || gameOver) return;
  const piece = player[index];

  if(!canPlay(piece)){
    setStatus("❌ Essa peça não combina com a mesa.");
    return;
  }

  player.splice(index, 1);
  placePiece(piece);

  if(player.length === 0){
    finishRound("player");
    return;
  }

  turn = "cpu";
  render();
  setStatus("🤖 Computador pensando...");
  setTimeout(cpuTurn, 800);
}

/* =========================
   SISTEMA DE DICA (HINT)
========================= */
function showHint(){
  if(turn !== "player" || gameOver) return;
  const validIndex = player.findIndex(canPlay);
  if(validIndex === -1){
    setStatus("💡 Você não possui jogadas válidas. Compre uma peça ou passe.");
    return;
  }
  const piecesEls = document.querySelectorAll(".player-piece");
  if(piecesEls[validIndex]){
    piecesEls[validIndex].classList.add("hint-highlight");
    setTimeout(() => {
      piecesEls[validIndex].classList.remove("hint-highlight");
    }, 2000);
  }
  setStatus("💡 Dica destacada na sua mão!");
}

/* =========================
   INTELIGÊNCIA ARTIFICIAL (CPU)
========================= */
function cpuTurn(){
  if(gameOver) return;

  // Fase 1: Comprar do monte se não tiver peça válida
  while(!cpu.some(canPlay) && deck.length > 0){
    cpu.push(deck.pop());
  }

  // Fase 2: Seleção de peça conforme dificuldade
  let index = -1;
  const validIndices = [];
  cpu.forEach((p, idx) => {
    if(canPlay(p)) validIndices.push(idx);
  });

  if(validIndices.length > 0){
    if(aiDifficulty === "easy"){
      // Escolhe aleatoriamente uma válida
      index = validIndices[Math.floor(Math.random() * validIndices.length)];
    } else if(aiDifficulty === "medium"){
      // Prefere peças com maior somatório de pontos
      index = validIndices.reduce((bestIdx, currIdx) => {
        const sumBest = cpu[bestIdx][0] + cpu[bestIdx][1];
        const sumCurr = cpu[currIdx][0] + cpu[currIdx][1];
        return sumCurr > sumBest ? currIdx : bestIdx;
      }, validIndices[0]);
    } else {
      // Difícil: Prioriza duplos ou peças que bloqueiam
      index = validIndices.reduce((bestIdx, currIdx) => {
        const pCurr = cpu[currIdx];
        const pBest = cpu[bestIdx];
        const isCurrDouble = pCurr[0] === pCurr[1];
        const isBestDouble = pBest[0] === pBest[1];
        if(isCurrDouble && !isBestDouble) return currIdx;
        return (pCurr[0] + pCurr[1] > pBest[0] + pBest[1]) ? currIdx : bestIdx;
      }, validIndices[0]);
    }
  }

  if(index !== -1){
    const piece = cpu.splice(index, 1)[0];
    placePiece(piece);

    if(cpu.length === 0){
      finishRound("cpu");
      return;
    }

    turn = "player";
    render();
    setStatus("👤 Sua vez!");
  } else {
    // Passa a vez caso continue sem jogada e monte zerado
    turn = "player";
    render();
    setStatus("🤖 Computador passou a vez. Sua vez!");
  }
}

/* =========================
   COMPRAR E PASSAR
========================= */
function drawPiece(){
  if(turn !== "player" || gameOver) return;
  if(deck.length === 0){
    setStatus("📦 O monte está vazio.");
    return;
  }
  const piece = deck.pop();
  player.push(piece);
  render();

  if(canPlay(piece)){
    setStatus("🃏 Você comprou uma peça jogável!");
  } else {
    setStatus("🃏 Peça comprada.");
  }
}

function passTurn(){
  if(turn !== "player" || gameOver) return;
  if(player.some(canPlay)){
    setStatus("⚠️ Você ainda possui jogadas válidas na mão.");
    return;
  }
  if(deck.length > 0){
    setStatus("⚠️ Ainda há peças no monte para comprar.");
    return;
  }

  turn = "cpu";
  render();
  setStatus("⏭ Você passou a vez. Computador jogando...");
  setTimeout(cpuTurn, 800);
}

/* =========================
   FINAL DE RODADA
========================= */
function finishRound(winner){
  gameOver = true;
  if(winner === "player"){
    playerScore++;
    $("resultText").textContent = "🎉 Parabéns! Você venceu a rodada!";
  } else {
    cpuScore++;
    $("resultText").textContent = "🤖 O computador venceu a rodada.";
  }
  render();
  setTimeout(() => {
    $("modal").classList.add("show");
  }, 300);
}

function setStatus(text){
  $("status").textContent = text;
}

function closeModal(){
  $("modal").classList.remove("show");
}
</script>


<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dominó PRO — Tabuleiro Curvo</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

:root{
  --bg:#06101c;
  --panel:#0c1b2d;
  --panel2:#132941;
  --accent:#00e5ff;
  --purple:#7c4dff;
  --text:#f4f7fb;
  --muted:#91a6bf;
  --green:#00e676;
  --gold:#ffd740;
}

body{
  min-height:100vh;
  font-family:Arial,Helvetica,sans-serif;
  color:var(--text);
  background:radial-gradient(circle at top,#173c65 0,#07111e 45%,#02070d 100%);
  overflow-x:hidden;
}

/* =========================
   TELA DE CAPA (SPLASH)
========================= */
.splash-screen{
  position:fixed;
  inset:0;
  background:radial-gradient(circle at center, #173c65 0, #07111e 60%, #02070d 100%);
  z-index:999;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:20px;
  transition:opacity .4s ease, visibility .4s ease;
}

.splash-screen.hidden{
  opacity:0;
  visibility:hidden;
  pointer-events:none;
}

.splash-logo-container{
  position:relative;
  width:140px;
  height:140px;
  display:flex;
  align-items:center;
  justify-content:center;
  margin-bottom:20px;
}

.splash-rings{
  position:absolute;
  inset:0;
  border:2px dashed var(--accent);
  border-radius:50%;
  animation: spinRings 10s linear infinite;
  box-shadow:0 0 25px rgba(0,229,255,.3);
}

@keyframes spinRings {
  100% { transform: rotate(360deg); }
}

.splash-domino{
  width:60px;
  height:100px;
  background:linear-gradient(145deg,#ffffff,#d8e0e8);
  border:2px solid var(--accent);
  border-radius:10px;
  display:flex;
  flex-direction:column;
  box-shadow:0 0 20px rgba(0,229,255,.6);
  transform:rotate(-15deg);
}

.splash-domino .half{
  flex:1;
  display:flex;
  align-items:center;
  justify-content:center;
  position:relative;
}
.splash-domino .half:first-child{
  border-bottom:2px solid #777;
}
.splash-dot{
  width:8px;
  height:8px;
  background:#111;
  border-radius:50%;
  position:absolute;
}

.splash-title{
  font-size:clamp(2.2rem, 6vw, 3.8rem);
  font-weight:900;
  background:linear-gradient(90deg,#00e5ff,#fff,#8d65ff);
  -webkit-background-clip:text;
  color:transparent;
  text-align:center;
  margin-bottom:5px;
  filter:drop-shadow(0 4px 15px rgba(0,229,255,.4));
}

.splash-subtitle{
  color:var(--muted);
  font-size:1.1rem;
  margin-bottom:35px;
  text-align:center;
}

.splash-buttons{
  display:flex;
  flex-direction:column;
  gap:14px;
  width:min(320px, 100%);
  align-items:center;
}

.btn-splash-main{
  width:100%;
  padding:16px 24px;
  font-size:1.15rem;
  font-weight:bold;
  border-radius:16px;
  border:none;
  background:linear-gradient(135deg,#00b4d8,#7c4dff);
  color:white;
  cursor:pointer;
  box-shadow:0 0 25px rgba(0,229,255,.4);
  transition:.2s;
  text-transform:uppercase;
  letter-spacing:1px;
}
.btn-splash-main:hover{
  transform:translateY(-3px);
  box-shadow:0 0 35px rgba(0,229,255,.7);
}

.splash-row-btns{
  display:flex;
  gap:10px;
  width:100%;
}

.btn-splash-sub{
  flex:1;
  padding:12px 15px;
  font-size:.95rem;
  font-weight:bold;
  border-radius:12px;
  border:1px solid #294765;
  background:var(--panel2);
  color:white;
  cursor:pointer;
  transition:.2s;
}
.btn-splash-sub:hover{
  border-color:var(--accent);
  transform:translateY(-2px);
}

/* =========================
   ESTRUTURA DO JOGO
========================= */
.app{
  width:min(1200px,96%);
  margin:auto;
  padding:20px 0 40px;
}

header{
  text-align:center;
  margin-bottom:18px;
}

header h1{
  font-size:clamp(2rem,5vw,3.5rem);
  font-weight:900;
  background:linear-gradient(90deg,#00e5ff,#fff,#8d65ff);
  -webkit-background-clip:text;
  color:transparent;
}

header p{
  color:var(--muted);
  margin-top:5px;
}

.topbar{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:10px;
  margin-bottom:15px;
}

.btn{
  border:1px solid #294765;
  background:var(--panel2);
  color:white;
  padding:11px 18px;
  border-radius:12px;
  cursor:pointer;
  font-weight:bold;
  transition:.2s;
}

.btn:hover{
  transform:translateY(-2px);
  border-color:var(--accent);
}

.btn.primary{
  background:linear-gradient(135deg,#008da8,#6840d9);
  border:0;
}

.btn.green{
  background:#087c49;
}

.btn.hint-btn{
  background:#b7791f;
  border-color:#d69e2e;
}

.game{
  background:rgba(12,27,45,.96);
  border:1px solid #203d5c;
  border-radius:22px;
  padding:18px;
  box-shadow:0 20px 60px rgba(0,0,0,.4);
}

.info{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
  margin-bottom:15px;
}

.stat{
  text-align:center;
  background:#081625;
  border:1px solid #1c3550;
  border-radius:14px;
  padding:11px;
}

.stat span{
  display:block;
  color:var(--muted);
  font-size:.8rem;
}

.stat strong{
  display:block;
  margin-top:4px;
}

.stat small{
  display:block;
  margin-top:3px;
  color:var(--accent);
  font-size:.75rem;
}

.status{
  text-align:center;
  background:#081625;
  border:1px solid #1d3a57;
  border-radius:14px;
  padding:13px;
  margin-bottom:15px;
  min-height:48px;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  flex-wrap:wrap;
}

/* =========================
   SELETOR DE PONTA
========================= */
.side-choice-bar{
  display:none;
  justify-content:center;
  align-items:center;
  gap:12px;
  background:#102a45;
  border:1px solid var(--accent);
  border-radius:14px;
  padding:10px 16px;
  margin-bottom:15px;
  animation: fadeIn .2s ease;
}

.side-choice-bar.show{
  display:flex;
  flex-wrap:wrap;
}

@keyframes fadeIn {
  from { opacity:0; transform:translateY(-5px); }
  to { opacity:1; transform:translateY(0); }
}

.btn-side{
  background:var(--accent);
  color:#04121f;
  border:none;
  padding:8px 16px;
  border-radius:10px;
  font-weight:bold;
  cursor:pointer;
  transition:.15s;
}

.btn-side:hover{
  transform:scale(1.05);
  box-shadow:0 0 12px rgba(0,229,255,.6);
}

.btn-cancel{
  background:transparent;
  border:1px solid #547291;
  color:#cbd8e8;
  padding:8px 12px;
  border-radius:10px;
  cursor:pointer;
}

/* =========================
   ÁREA DO TABULEIRO (ZIGUE-ZAGUE)
========================= */
.board{
  position:relative;
  height:450px;
  overflow-y:auto;
  overflow-x:auto;
  border-radius:22px;
  padding:24px;
  background:radial-gradient(circle at center,#126149,#083c30 55%,#05251f);
  border:5px solid #70431e;
  box-shadow:inset 0 0 35px rgba(0,0,0,.55), 0 10px 30px rgba(0,0,0,.25);
  display:flex;
  align-items:center;
  justify-content:center;
}

.board::before{
  content:"";
  position:absolute;
  inset:16px;
  border:1px solid rgba(255,255,255,.06);
  border-radius:18px;
  pointer-events:none;
}

.snake-board{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:8px;
  margin:auto;
  padding:10px;
}

.snake-row{
  display:flex;
  align-items:center;
  gap:4px;
  position:relative;
}

.snake-row.rtl{
  flex-direction:row-reverse;
}

.snake-turn{
  width:100%;
  display:flex;
  padding:0 18px;
}

.snake-turn.turn-right{
  justify-content:flex-end;
}

.snake-turn.turn-left{
  justify-content:flex-start;
}

/* =========================
   PEÇA
========================= */
.domino{
  width:54px;
  height:92px;
  border-radius:9px;
  background:linear-gradient(145deg,#ffffff,#d8e0e8);
  border:2px solid #aeb8c3;
  box-shadow:0 5px 12px rgba(0,0,0,.4);
  display:flex;
  flex-direction:column;
  overflow:hidden;
  flex-shrink:0;
  color:#111;
}

.snake-board .domino{
  width:88px;
  height:48px;
  flex-direction:row;
  transition:.25s;
}

.snake-board .domino.vertical{
  width:48px;
  height:88px;
  flex-direction:column;
}

.snake-board .domino:not(.vertical) .half{
  width:50%;
  height:100%;
}

.snake-board .domino:not(.vertical) .half:first-child{
  border-right:2px solid #777;
  border-bottom:0;
}

.snake-board .domino.vertical .half{
  width:100%;
  height:50%;
}

.snake-board .domino.vertical .half:first-child{
  border-right:0;
  border-bottom:2px solid #777;
}

.snake-board .domino.open-end{
  border-color:var(--accent);
  box-shadow: 0 0 16px rgba(0,229,255,.65);
}

.half{
  display:flex;
  align-items:center;
  justify-content:center;
  position:relative;
}

.dots{
  width:34px;
  height:34px;
  position:relative;
}

.dot{
  position:absolute;
  width:7px;
  height:7px;
  background:#111;
  border-radius:50%;
}

.tl{left:2px;top:2px}
.tc{left:13px;top:2px}
.tr{right:2px;top:2px}
.ml{left:2px;top:13px}
.mc{left:13px;top:13px}
.mr{right:2px;top:13px}
.bl{left:2px;bottom:2px}
.bc{left:13px;bottom:2px}
.br{right:2px;bottom:2px}

/* =========================
   COMPUTADOR
========================= */
.area-title{
  color:var(--muted);
  font-size:.9rem;
  margin-bottom:8px;
}

.hidden-hand{
  min-height:58px;
  display:flex;
  justify-content:center;
  gap:7px;
  margin-bottom:12px;
}

.back{
  width:36px;
  height:58px;
  border-radius:7px;
  background:repeating-linear-gradient(45deg,#132d4b,#132d4b 5px,#1d4b77 5px,#1d4b77 10px);
  border:2px solid #4e7da7;
}

/* =========================
   JOGADOR
========================= */
.player-area{
  margin-top:15px;
}

.hand{
  min-height:100px;
  display:flex;
  justify-content:center;
  gap:8px;
  flex-wrap:wrap;
}

.player-piece{
  cursor:pointer;
  transition:.2s;
}

.player-piece:hover:not(.disabled){
  transform:translateY(-10px);
  border-color:var(--accent);
  box-shadow:0 0 20px rgba(0,229,255,.5);
}

.player-piece.selected{
  transform:translateY(-14px);
  border-color:var(--accent);
  box-shadow:0 0 25px var(--accent);
}

.player-piece.disabled{
  opacity:.45;
  cursor:not-allowed;
}

.player-piece.hint-highlight{
  border-color:var(--gold) !important;
  box-shadow:0 0 22px var(--gold) !important;
  transform: translateY(-8px);
}

.controls{
  display:flex;
  justify-content:center;
  gap:10px;
  flex-wrap:wrap;
  margin-top:12px;
}

.rules{
  margin-top:15px;
  padding:16px;
  background:#081625;
  border:1px solid #1d3854;
  border-radius:16px;
}

.rules h2{
  margin-bottom:8px;
}

.rules ul{
  padding-left:20px;
  line-height:1.7;
  color:#cbd8e8;
}

/* =========================
   MODAL / TROFÉU / CONFIGURAÇÕES
========================= */
.modal{
  position:fixed;
  inset:0;
  display:none;
  align-items:center;
  justify-content:center;
  background:rgba(0,0,0,.78);
  z-index:1000;
  padding:20px;
}

.modal.show{
  display:flex;
}

.modal-box{
  width:min(460px,100%);
  background:#0c1b2d;
  border:1px solid #31516f;
  border-radius:20px;
  padding:25px;
  text-align:center;
}

.modal-box h2{
  color:var(--gold);
  margin-bottom:10px;
}

.modal-box p{
  color:#cbd8e8;
  line-height:1.6;
  margin-bottom:18px;
  text-align:left;
}

.trophy-badge{
  display:none;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  margin:10px auto 16px;
  padding:16px;
  border-radius:16px;
  background:radial-gradient(circle at top, rgba(255,215,64,.22), rgba(124,77,255,.12));
  border:1px solid rgba(255,215,64,.55);
  box-shadow:0 0 25px rgba(255,215,64,.22);
}

.trophy-badge.show{
  display:flex;
  animation: trophyPop .35s ease;
}

@keyframes trophyPop {
  from { transform:scale(.82); opacity:0; }
  to { transform:scale(1); opacity:1; }
}

.trophy-icon{
  font-size:3.2rem;
  line-height:1.1;
  filter:drop-shadow(0 0 14px rgba(255,215,64,.65));
}

.trophy-label{
  margin-top:6px;
  font-weight:bold;
  color:var(--gold);
  font-size:1rem;
  letter-spacing:.5px;
}

.form-group{
  margin-bottom:15px;
  text-align:left;
}

.form-group label{
  display:block;
  color:var(--muted);
  font-size:.9rem;
  margin-bottom:6px;
}

.form-group select{
  width:100%;
  padding:10px;
  background:#081625;
  border:1px solid #294765;
  color:white;
  border-radius:10px;
  font-size:1rem;
}

@media(max-width:700px){
  .info{
    grid-template-columns:repeat(2,1fr);
  }
  .board{
    height:410px;
    padding:12px;
  }
  .snake-board .domino{
    width:68px;
    height:38px;
  }
  .snake-board .domino.vertical{
    width:38px;
    height:68px;
  }
  .snake-turn{
    padding:0 12px;
  }
  .dots{
    transform:scale(.72);
  }
}
</style>
</head>

<body>

<!-- TELA DE CAPA (SPLASH SCREEN) -->
<div class="splash-screen" id="splashScreen">
  <div class="splash-logo-container">
    <div class="splash-rings"></div>
    <div class="splash-domino">
      <div class="half">
        <span class="splash-dot" style="left:5px;top:5px;"></span>
        <span class="splash-dot" style="right:5px;bottom:5px;"></span>
      </div>
      <div class="half">
        <span class="splash-dot" style="left:5px;top:5px;"></span>
        <span class="splash-dot" style="right:5px;bottom:5px;"></span>
        <span class="splash-dot" style="left:12px;top:12px;"></span>
      </div>
    </div>
  </div>

  <h1 class="splash-title">DOMINÓ PRO</h1>
  <p class="splash-subtitle">Desafie a Sorte e a Estratégia</p>

  <div class="splash-buttons">
    <button class="btn-splash-main" onclick="closeSplash()">INICIAR JOGO</button>
    <div class="splash-row-btns">
      <button class="btn-splash-sub" onclick="openRulesModal()">Como Jogar</button>
      <button class="btn-splash-sub" onclick="openSettingsModal()">Configurações</button>
    </div>
  </div>
</div>

<div class="app">

<header>
  <h1>🁣 DOMINÓ PRO</h1>
  <p>Tabuleiro em zigue-zague e Inteligência Artificial</p>
</header>

<div class="topbar">
  <button class="btn primary" onclick="startNewSeries()">🔄 Nova Série</button>
  <button class="btn" onclick="openRulesModal()">📖 Regras</button>
  <button class="btn" onclick="openSettingsModal()">⚙️ Configurações</button>
</div>

<div class="game">

<div class="info">
  <div class="stat">
    <span>Jogador</span>
    <strong id="playerCount">0 peças</strong>
  </div>
  <div class="stat">
    <span>Computador</span>
    <strong id="cpuCount">0 peças</strong>
  </div>
  <div class="stat">
    <span>Monte</span>
    <strong id="deckCount">0 peças</strong>
  </div>
  <div class="stat">
    <span>Placar</span>
    <strong id="score">0 × 0</strong>
    <small id="matchFormatLabel">Livre</small>
  </div>
</div>

<div class="status" id="status">
  Clique em "Iniciar Jogo".
</div>

<!-- BARRA DE ESCOLHA DE PONTA -->
<div class="side-choice-bar" id="sideChoiceBar">
  <span>Essa peça encaixa nos dois lados! Onde deseja jogar?</span>
  <button class="btn-side" id="btnChooseLeft">⬅️ Ponta Esquerda</button>
  <button class="btn-side" id="btnChooseRight">Ponta Direita ➡️</button>
  <button class="btn-cancel" onclick="cancelSideChoice()">Cancelar</button>
</div>

<div>
  <div class="area-title">🤖 Mão do Computador</div>
  <div class="hidden-hand" id="cpuHand"></div>
</div>

<!-- TABULEIRO -->
<div class="board" id="boardWrapper">
  <div class="snake-board" id="board">
    <span style="color:#b9d4cb">A corrente de dominó aparecerá aqui</span>
  </div>
</div>

<div class="player-area">
  <div class="area-title">👤 Sua Mão — clique para jogar</div>
  <div class="hand" id="playerHand"></div>
</div>

<div class="controls">
  <button class="btn green" onclick="drawPiece()">➕ Comprar Peça</button>
  <button class="btn hint-btn" onclick="showHint()">💡 Dica</button>
  <button class="btn" onclick="passTurn()">⏭ Passar</button>
</div>

<div class="rules">
  <h2>📜 Regras Rápidas</h2>
  <ul>
    <li>28 peças no dominó tradicional. Cada jogador começa com 7 peças.</li>
    <li>Combine uma peça com uma das pontas destacadas na mesa (se servir nas duas, escolha o lado).</li>
    <li>No modo <strong>Melhor de 3</strong> (vence com 2) ou <strong>Melhor de 5</strong> (vence com 3), o primeiro a atingir a meta leva o troféu!</li>
    <li>Vence a rodada quem bater primeiro ou, se o jogo trancar, quem tiver menos pontos na mão!</li>
  </ul>
</div>

</div>
</div>

<!-- MODAL DE FIM DE RODADA / TROFÉU -->
<div class="modal" id="modal">
  <div class="modal-box">
    <h2 id="modalTitle">🏆 Fim da Rodada</h2>
    <div class="trophy-badge" id="trophyBadge">
      <div class="trophy-icon" id="trophyIcon">🏆</div>
      <div class="trophy-label" id="trophyLabel">CAMPEÃO DA SÉRIE</div>
    </div>
    <p id="resultText"></p>
    <button class="btn primary" id="modalActionBtn" style="width:100%;" onclick="handleModalAction()">🔄 Próxima Rodada</button>
  </div>
</div>

<!-- MODAL DE REGRAS -->
<div class="modal" id="rulesModal">
  <div class="modal-box">
    <h2>📖 Como Jogar</h2>
    <p>
1. O jogo começa distribuindo 7 peças para você e 7 para o computador.<br>
2. Na sua vez, selecione uma peça que coincida com uma das pontas abertas (destacadas em azul na mesa). Caso encaixe nos dois lados, escolha qual ponta usar.<br>
3. Caso não possua peças válidas, utilize o botão <strong>Comprar Peça</strong>.<br>
4. Se o monte estiver vazio e ninguém puder jogar (jogo trancado), vence a rodada quem somar <strong>menos pontos</strong> nas peças restantes.<br>
5. Em séries <strong>Melhor de 3</strong> ou <strong>Melhor de 5</strong>, quem atingir a maioria de vitórias primeiro conquista o troféu de campeão!
    </p>
    <button class="btn primary" style="width:100%;" onclick="closeRulesModal()">Entendi</button>
  </div>
</div>

<!-- MODAL DE CONFIGURAÇÕES -->
<div class="modal" id="settingsModal">
  <div class="modal-box">
    <h2>⚙️ Configurações</h2>
    <div class="form-group">
      <label for="matchModeSelect">Formato da Partida:</label>
      <select id="matchModeSelect" onchange="changeMatchMode(this.value)">
        <option value="free" selected>Livre (Sem limite de rodadas)</option>
        <option value="bo3">Melhor de 3 (Primeiro a 2 vitórias)</option>
        <option value="bo5">Melhor de 5 (Primeiro a 3 vitórias)</option>
      </select>
    </div>
    <div class="form-group">
      <label for="aiDifficulty">Dificuldade da IA:</label>
      <select id="aiDifficulty" onchange="changeDifficulty(this.value)">
        <option value="easy">Fácil (Iniciante)</option>
        <option value="medium" selected>Médio (Estratégico)</option>
        <option value="hard">Difícil (Mestre)</option>
      </select>
    </div>
    <button class="btn primary" style="width:100%;" onclick="closeSettingsModal()">Salvar e Fechar</button>
  </div>
</div>

<script>
let deck = [];
let player = [];
let cpu = [];
let board = [];
let turn = "player";
let playerScore = 0;
let cpuScore = 0;
let gameOver = false;
let seriesOver = false;
let aiDifficulty = "medium";
let matchMode = "free"; // "free" | "bo3" | "bo5"
let consecutivePasses = 0;
let pendingPieceIndex = null;

const $ = id => document.getElementById(id);

function getTargetWins(){
  if(matchMode === "bo3") return 2;
  if(matchMode === "bo5") return 3;
  return null;
}

function getMatchModeLabel(){
  if(matchMode === "bo3") return "Melhor de 3 (Meta: 2)";
  if(matchMode === "bo5") return "Melhor de 5 (Meta: 3)";
  return "Modo Livre";
}

function closeSplash(){
  $("splashScreen").classList.add("hidden");
  startNewSeries();
}

function openRulesModal(){ $("rulesModal").classList.add("show"); }
function closeRulesModal(){ $("rulesModal").classList.remove("show"); }

function openSettingsModal(){
  $("matchModeSelect").value = matchMode;
  $("aiDifficulty").value = aiDifficulty;
  $("settingsModal").classList.add("show");
}
function closeSettingsModal(){ $("settingsModal").classList.remove("show"); }

function changeDifficulty(val){
  aiDifficulty = val;
}

function changeMatchMode(val){
  matchMode = val;
  startNewSeries();
}

/* =========================
   BARALHO E JOGO
========================= */
function createDeck(){
  const d = [];
  for(let a=0; a<=6; a++){
    for(let b=a; b<=6; b++){
      d.push([a,b]);
    }
  }
  return d;
}

function shuffle(array){
  for(let i=array.length-1; i>0; i--){
    const j = Math.floor(Math.random()*(i+1));
    [array[i], array[j]] = [array[j], array[i]];
  }
}

function startNewSeries(){
  playerScore = 0;
  cpuScore = 0;
  seriesOver = false;
  newRound();
}

function newRound(){
  deck = createDeck();
  shuffle(deck);
  player = deck.splice(0, 7);
  cpu = deck.splice(0, 7);
  board = [];
  turn = "player";
  gameOver = false;
  consecutivePasses = 0;
  cancelSideChoice();
  render();
  setStatus(`👤 Sua vez! (${getMatchModeLabel()})`);
}

/* =========================
   RENDERIZAÇÃO
========================= */
function render(){
  renderPlayer();
  renderCPU();
  renderBoard();

  $("playerCount").textContent = player.length + (player.length === 1 ? " peça" : " peças");
  $("cpuCount").textContent = cpu.length + (cpu.length === 1 ? " peça" : " peças");
  $("deckCount").textContent = deck.length + (deck.length === 1 ? " peça" : " peças");
  $("score").textContent = playerScore + " × " + cpuScore;
  $("matchFormatLabel").textContent = getMatchModeLabel();
}

function renderPlayer(){
  const hand = $("playerHand");
  hand.innerHTML = "";
  player.forEach((piece, index) => {
    const el = createDomino(piece[0], piece[1]);
    el.classList.add("player-piece");
    if(pendingPieceIndex === index){
      el.classList.add("selected");
    }
    if(turn !== "player" || !canPlay(piece)){
      el.classList.add("disabled");
    } else {
      el.onclick = () => handlePlayerClick(index);
    }
    hand.appendChild(el);
  });
}

function renderCPU(){
  const hand = $("cpuHand");
  hand.innerHTML = "";
  cpu.forEach(() => {
    const back = document.createElement("div");
    back.className = "back";
    hand.appendChild(back);
  });
}

/* =========================
   TABULEIRO EM ZIGUE-ZAGUE (SERPENTINA)
========================= */
function getPiecesPerRow(){
  const wrapperWidth = $("boardWrapper") ? $("boardWrapper").clientWidth : window.innerWidth;
  if(wrapperWidth < 520) return 4;
  if(wrapperWidth < 820) return 6;
  return 8;
}

function renderBoard(){
  const area = $("board");
  area.innerHTML = "";

  if(board.length === 0){
    area.innerHTML = '<span style="color:#b9d4cb">A corrente de dominó aparecerá aqui</span>';
    return;
  }

  const perRow = getPiecesPerRow();
  let cursor = 0;
  let rowIndex = 0;

  while(cursor < board.length){
    const isRTL = (rowIndex % 2 === 1);
    const rowEl = document.createElement("div");
    rowEl.className = "snake-row" + (isRTL ? " rtl" : "");

    const rowEnd = Math.min(cursor + perRow, board.length);

    for(let i = cursor; i < rowEnd; i++){
      const piece = board[i];
      const displayA = isRTL ? piece[1] : piece[0];
      const displayB = isRTL ? piece[0] : piece[1];

      const el = createDomino(displayA, displayB);

      if(piece[0] === piece[1]){
        el.classList.add("vertical");
      }

      if(i === 0 || i === board.length - 1){
        el.classList.add("open-end");
      }

      rowEl.appendChild(el);
    }

    area.appendChild(rowEl);
    cursor = rowEnd;

    if(cursor < board.length){
      const turnPiece = board[cursor];
      const turnWrapper = document.createElement("div");
      turnWrapper.className = "snake-turn " + (!isRTL ? "turn-right" : "turn-left");

      const turnEl = createDomino(turnPiece[0], turnPiece[1]);
      turnEl.classList.add("vertical");

      if(cursor === board.length - 1){
        turnEl.classList.add("open-end");
      }

      turnWrapper.appendChild(turnEl);
      area.appendChild(turnWrapper);
      cursor++;
    }

    rowIndex++;
  }
}

window.addEventListener("resize", () => {
  if(board.length > 0) renderBoard();
});

function createDomino(a, b){
  const el = document.createElement("div");
  el.className = "domino";
  el.appendChild(createHalf(a));
  el.appendChild(createHalf(b));
  return el;
}

function createHalf(value){
  const half = document.createElement("div");
  half.className = "half";
  const dots = document.createElement("div");
  dots.className = "dots";

  const positions = {
    0: [],
    1: ["mc"],
    2: ["tl", "br"],
    3: ["tl", "mc", "br"],
    4: ["tl", "tr", "bl", "br"],
    5: ["tl", "tr", "mc", "bl", "br"],
    6: ["tl", "ml", "bl", "tr", "mr", "br"]
  };

  positions[value].forEach(pos => {
    const dot = document.createElement("span");
    dot.className = "dot " + pos;
    dots.appendChild(dot);
  });

  half.appendChild(dots);
  return half;
}

/* =========================
   LÓGICA DE JOGADAS E PONTAS
========================= */
function getValidSides(piece, currentBoard = board){
  if(currentBoard.length === 0) return ["right"];
  const left = currentBoard[0][0];
  const right = currentBoard[currentBoard.length - 1][1];
  const canLeft = (piece[0] === left || piece[1] === left);
  const canRight = (piece[0] === right || piece[1] === right);

  if(canLeft && canRight && left === right && piece[0] === piece[1]){
    return ["right"];
  }

  const sides = [];
  if(canLeft) sides.push("left");
  if(canRight) sides.push("right");
  return sides;
}

function canPlay(piece, currentBoard = board){
  return getValidSides(piece, currentBoard).length > 0;
}

function simulateBoardPlacement(piece, side, currentBoard = board){
  const nextBoard = currentBoard.map(p => [...p]);
  if(nextBoard.length === 0){
    nextBoard.push([...piece]);
    return nextBoard;
  }
  const left = nextBoard[0][0];
  const right = nextBoard[nextBoard.length - 1][1];

  if(side === "left"){
    if(piece[1] === left){
      nextBoard.unshift([...piece]);
    } else {
      nextBoard.unshift([piece[1], piece[0]]);
    }
  } else {
    if(piece[0] === right){
      nextBoard.push([...piece]);
    } else {
      nextBoard.push([piece[1], piece[0]]);
    }
  }
  return nextBoard;
}

function placePieceOnSide(piece, side){
  board = simulateBoardPlacement(piece, side, board);
}

/* =========================
   JOGADOR
========================= */
function handlePlayerClick(index){
  if(turn !== "player" || gameOver) return;
  const piece = player[index];
  const sides = getValidSides(piece);

  if(sides.length === 0){
    setStatus("❌ Essa peça não combina com nenhuma ponta da mesa.");
    return;
  }

  if(sides.length === 2){
    pendingPieceIndex = index;
    const leftVal = board[0][0];
    const rightVal = board[board.length - 1][1];
    $("btnChooseLeft").textContent = `⬅️ Início (${leftVal})`;
    $("btnChooseRight").textContent = `Final (${rightVal}) ➡️`;
    $("btnChooseLeft").onclick = () => executePlayerMove(index, "left");
    $("btnChooseRight").onclick = () => executePlayerMove(index, "right");
    $("sideChoiceBar").classList.add("show");
    renderPlayer();
    return;
  }

  executePlayerMove(index, sides[0]);
}

function cancelSideChoice(){
  pendingPieceIndex = null;
  $("sideChoiceBar").classList.remove("show");
  renderPlayer();
}

function executePlayerMove(index, side){
  cancelSideChoice();
  const piece = player.splice(index, 1)[0];
  placePieceOnSide(piece, side);
  consecutivePasses = 0;

  if(player.length === 0){
    finishRound("player", "bater");
    return;
  }

  turn = "cpu";
  render();
  setStatus("🤖 Computador pensando...");
  setTimeout(cpuTurn, 800);
}

/* =========================
   SISTEMA DE DICA (HINT)
========================= */
function showHint(){
  if(turn !== "player" || gameOver) return;
  const validIndex = player.findIndex(canPlay);
  if(validIndex === -1){
    if(deck.length > 0){
      setStatus("💡 Sem jogadas! Clique em 'Comprar Peça'.");
    } else {
      setStatus("💡 Sem jogadas e monte vazio! Clique em 'Passar'.");
    }
    return;
  }
  const piecesEls = document.querySelectorAll(".player-piece");
  if(piecesEls[validIndex]){
    piecesEls[validIndex].classList.add("hint-highlight");
    setTimeout(() => {
      piecesEls[validIndex].classList.remove("hint-highlight");
    }, 2000);
  }
  setStatus("💡 Dica destacada na sua mão!");
}

/* =========================
   INTELIGÊNCIA ARTIFICIAL (CPU)
========================= */
function getRemainingFrequency(hand, excludeIndex){
  const freq = Array(7).fill(0);
  hand.forEach((p, idx) => {
    if(idx === excludeIndex) return;
    freq[p[0]]++;
    if(p[1] !== p[0]) freq[p[1]]++;
    else freq[p[0]]++;
  });
  return freq;
}

function scoreHardMove(move, cpuHand, currentBoard, remainingDeckCount, playerHandCount){
  const { index, piece, side } = move;
  const nextBoard = simulateBoardPlacement(piece, side, currentBoard);
  const remainingHand = cpuHand.filter((_, idx) => idx !== index);
  const freq = getRemainingFrequency(cpuHand, index);

  let score = 0;

  if(remainingHand.length === 0){
    return 10000;
  }

  const newLeft = nextBoard[0][0];
  const newRight = nextBoard[nextBoard.length - 1][1];

  score += freq[newLeft] * 14;
  score += freq[newRight] * 14;

  const cpuStillHasNewLeft = remainingHand.some(p => p[0] === newLeft || p[1] === newLeft);
  const cpuStillHasNewRight = remainingHand.some(p => p[0] === newRight || p[1] === newRight);
  if(!cpuStillHasNewLeft) score -= 12;
  if(!cpuStillHasNewRight) score -= 12;

  const piecePoints = piece[0] + piece[1];
  score += piecePoints * 2.2;

  if(piece[0] === piece[1] && remainingHand.length > 2){
    score += 8;
  }

  const cpuPointsAfter = sumHandPoints(remainingHand);
  const estimatedPlayerPoints = playerHandCount * 5.5;
  const hasPointsAdvantage = cpuPointsAfter + 3 < estimatedPlayerPoints;
  const followUpPlays = remainingHand.filter(p => canPlay(p, nextBoard)).length;
  const endgamePressure = remainingDeckCount === 0 ? 1.6 : (remainingDeckCount <= 3 ? 0.8 : 0.25);

  if(hasPointsAdvantage){
    if(followUpPlays === 0 && remainingDeckCount === 0){
      score += 45 * endgamePressure;
    } else if(newLeft === newRight){
      score += 18 * endgamePressure;
    }
  } else {
    if(followUpPlays === 0 && remainingDeckCount === 0){
      score -= 55 * endgamePressure;
    } else if(followUpPlays === 0){
      score -= 14 * endgamePressure;
    }
    score += piecePoints * 1.5;
  }

  return score;
}

function chooseHardMove(validMoves){
  let bestMove = validMoves[0];
  let bestScore = -Infinity;

  for(const move of validMoves){
    const s = scoreHardMove(move, cpu, board, deck.length, player.length);
    if(s > bestScore){
      bestScore = s;
      bestMove = move;
    }
  }
  return bestMove;
}

function cpuTurn(){
  if(gameOver) return;

  while(!cpu.some(canPlay) && deck.length > 0){
    cpu.push(deck.pop());
  }

  const validMoves = [];
  cpu.forEach((p, idx) => {
    const sides = getValidSides(p);
    sides.forEach(side => {
      validMoves.push({ index: idx, piece: p, side });
    });
  });

  if(validMoves.length > 0){
    let chosenMove = validMoves[0];

    if(aiDifficulty === "easy"){
      chosenMove = validMoves[Math.floor(Math.random() * validMoves.length)];
    } else if(aiDifficulty === "medium"){
      chosenMove = validMoves.reduce((best, curr) => {
        const sumBest = best.piece[0] + best.piece[1];
        const sumCurr = curr.piece[0] + curr.piece[1];
        return sumCurr > sumBest ? curr : best;
      }, validMoves[0]);
    } else {
      chosenMove = chooseHardMove(validMoves);
    }

    const piece = cpu.splice(chosenMove.index, 1)[0];
    placePieceOnSide(piece, chosenMove.side);
    consecutivePasses = 0;

    if(cpu.length === 0){
      finishRound("cpu", "bater");
      return;
    }

    turn = "player";
    render();
    setStatus("👤 Sua vez!");
  } else {
    consecutivePasses++;
    if(consecutivePasses >= 2 && deck.length === 0){
      resolveLockedGame();
      return;
    }
    turn = "player";
    render();
    setStatus("🤖 Computador passou a vez. Sua vez!");
  }
}

/* =========================
   COMPRAR, PASSAR E JOGO TRANCADO
========================= */
function drawPiece(){
  if(turn !== "player" || gameOver) return;
  if(player.some(canPlay)){
    setStatus("⚠️ Você já possui uma peça válida na mão!");
    return;
  }
  if(deck.length === 0){
    setStatus("📦 O monte está vazio. Se não tiver jogada, clique em 'Passar'.");
    return;
  }

  cancelSideChoice();
  const piece = deck.pop();
  player.push(piece);
  render();

  if(canPlay(piece)){
    setStatus(`🃏 Você comprou [${piece[0]}|${piece[1]}] e já pode jogar!`);
  } else if(deck.length > 0){
    setStatus(`🃏 Você comprou [${piece[0]}|${piece[1]}]. Compre novamente.`);
  } else {
    setStatus(`🃏 Você comprou [${piece[0]}|${piece[1]}] e o monte acabou!`);
  }
}

function passTurn(){
  if(turn !== "player" || gameOver) return;
  if(player.some(canPlay)){
    setStatus("⚠️ Você ainda possui jogadas válidas na mão.");
    return;
  }
  if(deck.length > 0){
    setStatus("⚠️ Ainda há peças no monte para comprar.");
    return;
  }

  cancelSideChoice();
  consecutivePasses++;

  if(consecutivePasses >= 2){
    resolveLockedGame();
    return;
  }

  turn = "cpu";
  render();
  setStatus("⏭ Você passou a vez. Computador jogando...");
  setTimeout(cpuTurn, 800);
}

function sumHandPoints(hand){
  return hand.reduce((total, piece) => total + piece[0] + piece[1], 0);
}

function resolveLockedGame(){
  const playerPoints = sumHandPoints(player);
  const cpuPoints = sumHandPoints(cpu);

  if(playerPoints < cpuPoints){
    finishRound("player", "trancado", playerPoints, cpuPoints);
  } else if(cpuPoints < playerPoints){
    finishRound("cpu", "trancado", playerPoints, cpuPoints);
  } else {
    finishRound("draw", "trancado", playerPoints, cpuPoints);
  }
}

/* =========================
   FINAL DE RODADA E TROFÉU
========================= */
function finishRound(winner, reason, pPts = 0, cPts = 0){
  gameOver = true;
  cancelSideChoice();

  if(winner === "player"){
    playerScore++;
  } else if(winner === "cpu"){
    cpuScore++;
  }

  const targetWins = getTargetWins();
  let champion = null;
  if(targetWins !== null){
    if(playerScore >= targetWins) champion = "player";
    else if(cpuScore >= targetWins) champion = "cpu";
  }

  const trophyBadge = $("trophyBadge");
  trophyBadge.classList.remove("show");

  if(champion !== null){
    seriesOver = true;
    trophyBadge.classList.add("show");
    if(champion === "player"){
      $("modalTitle").textContent = "👑 Campeão do Dominó PRO!";
      $("trophyIcon").textContent = "🏆";
      $("trophyLabel").textContent = `TROFÉU DE CAMPEÃO (${playerScore} × ${cpuScore})`;
    } else {
      $("modalTitle").textContent = "🤖 Vitória do Computador na Série";
      $("trophyIcon").textContent = "🏆";
      $("trophyLabel").textContent = `TROFÉU DO COMPUTADOR (${cpuScore} × ${playerScore})`;
    }
    $("modalActionBtn").textContent = "🔄 Nova Série";
  } else {
    seriesOver = false;
    $("modalTitle").textContent = reason === "trancado" ? "🔒 Jogo Trancado!" : "🏆 Fim da Rodada";
    $("modalActionBtn").textContent = "🔄 Próxima Rodada";
  }

  let bodyHtml = "";
  if(reason === "trancado"){
    bodyHtml += `Ninguém tem mais jogadas possíveis!<br>
      <strong>Seus pontos na mão:</strong> ${pPts}<br>
      <strong>Pontos do Computador:</strong> ${cPts}<br><br>`;
    if(winner === "player"){
      bodyHtml += "🎉 Você venceu a rodada por ter menos pontos!";
    } else if(winner === "cpu"){
      bodyHtml += "🤖 O computador venceu a rodada por ter menos pontos.";
    } else {
      bodyHtml += "🤝 Empate técnico na rodada!";
    }
  } else {
    if(winner === "player"){
      bodyHtml += "🎉 Parabéns! Você bateu e venceu a rodada!";
    } else {
      bodyHtml += "🤖 O computador bateu e venceu a rodada.";
    }
  }

  bodyHtml += `<br><br><strong>Placar da série:</strong> ${playerScore} × ${cpuScore}`;
  if(champion === "player"){
    bodyHtml += `<br>🏅 Você conquistou o troféu da série!`;
  } else if(champion === "cpu"){
    bodyHtml += `<br>🤖 O computador conquistou o troféu desta série.`;
  }

  $("resultText").innerHTML = bodyHtml;

  render();
  setTimeout(() => {
    $("modal").classList.add("show");
  }, 300);
}

function handleModalAction(){
  closeModal();
  if(seriesOver){
    startNewSeries();
  } else {
    newRound();
  }
}

function setStatus(text){
  $("status").textContent = text;
}

function closeModal(){
  $("modal").classList.remove("show");
}
</script>

